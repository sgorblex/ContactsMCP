# ContactsMCP configuration. Copy to `.env` (gitignored) and edit.
#
# Used as `env_file` by Compose, `--env-file` by podman/docker run, `EnvironmentFile=` by
# systemd/Quadlet. Do NOT quote values: `podman --env-file` (and systemd) keep the quotes as
# part of the value, so KEY="value" would be read as "value" with the quotes. Write KEY=value.
#
# Every secret can be given either directly (NAME=...) or as a file (NAME_FILE=/path), which is
# how Docker/Podman secrets are mounted (/run/secrets/<name>). Setting both is a startup error.

# --- Google client -----------------------------------------------------------------------
# The Google Cloud OAuth client of type "Desktop app", shared by every linked account
# (see the README, "Google Cloud setup"). Either the two values...
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CLIENT_SECRET_FILE=/run/secrets/google_client_secret
# GOOGLE_CLIENT_ID_FILE=/run/secrets/google_client_id
# ...or the JSON downloaded from the console (its "installed" key; a "web" client is rejected).
# Set one way or the other, not both.
# GOOGLE_CLIENT_SECRETS_FILE=/run/secrets/google_client_secrets.json

# --- Transport and general ---------------------------------------------------------------
# stdio (default when running locally) or http (the container image sets http).
# CONTACTS_MCP_TRANSPORT=http
# Where the account files live (accounts/<alias>.json, mode 0600). /data in the image,
# $XDG_DATA_HOME/contacts-mcp (~/.local/share/contacts-mcp) otherwise.
# CONTACTS_MCP_DATA_DIR=/data
# Server name shown to MCP clients.
# CONTACTS_MCP_SERVER_NAME=contacts

# --- HTTP and OAuth (required when CONTACTS_MCP_TRANSPORT=http) --------------------------
# Listen address inside the container; publish the port, terminate TLS at a reverse proxy.
# CONTACTS_MCP_HOST=0.0.0.0
# CONTACTS_MCP_PORT=8000

# The public URL clients use, with no trailing path. Must match what the reverse proxy serves:
# it is the OAuth issuer and the allowed Host. The IdP redirect URI is <base_url>/auth/callback.
CONTACTS_MCP_BASE_URL=https://contacts.example.com

# The OpenID Connect provider that signs people in (authentik, Keycloak, Google, ...).
CONTACTS_MCP_OIDC_CONFIG_URL=https://auth.example.com/application/o/contacts-mcp/.well-known/openid-configuration
CONTACTS_MCP_OIDC_CLIENT_ID=
CONTACTS_MCP_OIDC_CLIENT_SECRET=
# CONTACTS_MCP_OIDC_CLIENT_ID_FILE=/run/secrets/oidc_client_id
# CONTACTS_MCP_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret

# Scopes requested from the OIDC provider. The default is `openid email offline_access`.
# Google as the IdP rejects offline_access: use the three Google lines below instead.
# CONTACTS_MCP_OIDC_UPSTREAM_SCOPES=openid email offline_access
# Extra authorization parameters (key=value&key=value; `scope` is not allowed here) and whether
# to verify the ID token rather than the access token. For Google as the IdP:
# CONTACTS_MCP_OIDC_UPSTREAM_SCOPES=openid email
# CONTACTS_MCP_OIDC_EXTRA_AUTHORIZE_PARAMS=access_type=offline&prompt=consent
# CONTACTS_MCP_OIDC_VERIFY_ID_TOKEN=true

# At least 32 random characters (e.g. `openssl rand -base64 48`). Signs the server's own tokens
# and derives the key that encrypts the OAuth state under FASTMCP_HOME. Changing it
# disconnects every client (they sign in again); it does not touch the account files.
CONTACTS_MCP_JWT_SIGNING_KEY=
# CONTACTS_MCP_JWT_SIGNING_KEY_FILE=/run/secrets/jwt_signing_key

# Who may use the server: comma-separated e-mail addresses (matched only when the provider says
# the e-mail is verified) and/or OIDC `sub` values. Required. Essential with a public provider
# such as Google: without it, anyone with an account there could sign in.
CONTACTS_MCP_ALLOWED_USERS=you@example.com

# Redirect URIs MCP clients may register, comma-separated; `:*` is a port wildcard. The default
# is claude.ai, claude.com and Claude Code's loopback callback:
#   https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,http://localhost:*/callback,http://127.0.0.1:*/callback
# CONTACTS_MCP_ALLOWED_REDIRECT_URIS=

# Behind a reverse proxy: take the client's address and scheme from X-Forwarded-For/-Proto,
# only when they come from these peers.
# CONTACTS_MCP_TRUST_FORWARDED_HEADERS=true
# CONTACTS_MCP_FORWARDED_ALLOW_IPS=127.0.0.1

# Serve the account settings page at <base_url>/settings. Needs the redirect URI
# <base_url>/settings/auth/callback at the identity provider.
# CONTACTS_MCP_SETTINGS_PAGE=true

# Where the OAuth client registrations and upstream tokens are stored (/oauth in the image).
# Disposable: deleting it only makes MCP clients sign in again.
# FASTMCP_HOME=/oauth

# --- Exposure ----------------------------------------------------------------------------
# Which tools the server offers: `all` (default) or `read-only` (only tools annotated read-only),
# optionally followed by `+tool,tool` (add) and/or `-tool,tool` (remove). An unknown tool name
# stops the server at startup. Examples:
#   read-only
#   read-only+create_contact,update_contact
#   all-delete_contact,delete_group
#   read-only+create_contact-search_other_contacts
# CONTACTS_MCP_EXPOSED_TOOLS=all

# --- Logging -----------------------------------------------------------------------------
# JSON lines on stderr. DEBUG, INFO, WARNING or ERROR.
# CONTACTS_MCP_LOG_LEVEL=INFO
